# Copy to .env and fill in. Never commit .env.

# --- server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
# guards every button that changes something (approvals, switches, whitelist)
OPERATOR_PASSCODE=
DRILL=true
APPROVAL_DEFAULT=true
# set to bed_count to stage the verifier catch; leave empty otherwise
DEMO_INJECT_FAULT=
DATABASE_PATH=data/sentinel.db
TAPE_DIR=data/tapes
ARTIFACTS_DIR=data/artifacts
# live | record | replay | live-with-fallback  (per source: TAPE_MODE_USGS=replay etc.)
TAPE_MODE_DEFAULT=live-with-fallback
SCIENCE_URL=http://127.0.0.1:8001
TIER2_MIN_POP=10000
DAMAGE_MMI=7
# poll USGS, GDACS, EONET, SWPC, NWS and FIRMS (turn on for live mode)
FEEDS=false
# p90 plans hospitals against the high end of the casualty range; p50 against the middle
CASUALTY_PLANNING=p90
# record every call (dual channel)
VOICE_RECORD=true
# only needed when TWILIO_AUTH_TOKEN is not set: a secret added to webhook URLs
VOICE_WEBHOOK_SECRET=
# public APIs ask for a way to reach us; this goes in the User-Agent where they want it
CONTACT_EMAIL=

# --- language models ---
# comma list of provider:model, tried in order. Providers: gemini, groq, openrouter
LLM_CHAIN_VOICE=gemini:gemini-2.5-flash-lite,gemini:gemini-2.5-flash,groq:openai/gpt-oss-20b
LLM_CHAIN_TEXT=gemini:gemini-2.5-flash,gemini:gemini-2.5-flash-lite,groq:openai/gpt-oss-120b
# Sentinel's own Google projects only. Quota is per project, so extra keys only help if they
# come from different projects. _2 … _9 are read too.
GEMINI_API_KEY=
# the sitrep lane: some thinking helps the prose, unbounded thinking can eat the whole budget
GEMINI_REASONING_EFFORT=low
# thinking adds a second or more before the first word on a call
GEMINI_REASONING_EFFORT_VOICE=none
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- voice ---
TWILIO_ACCOUNT_SID=
# the auth token is only used to check webhook signatures
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_NUMBER=
TWILIO_TWIML_APP_SID=
# speech both ways: Nova-3 listens, Aura-2 speaks, both in the call's own 8 kHz mu-law
DEEPGRAM_API_KEY=
VOICE_TTS_MODEL=aura-2-thalia-en
# silence (ms) before Deepgram calls a turn finished, and the fallback for noisy trailing-off
VOICE_ENDPOINT_MS=350
VOICE_UTTERANCE_END_MS=1000

# --- data services ---
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
AIRNOW_API_KEY=
ORS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_FLOODHUB_API_KEY=
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
